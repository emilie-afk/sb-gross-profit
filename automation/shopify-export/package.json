{
  "name": "sb-shopify-export",
  "version": "0.1.0",
  "private": true,
  "description": "Weekly rolling Shopify orders export for the SB GP pipeline (runs on the Windows host; no Shopify API)",
  "type": "module",
  "scripts": {
    "login": "node src/login.mjs --config config.local.json",
    "gmail-authorize": "node src/gmail-authorize.mjs --config config.local.json",
    "export": "node src/export.mjs --config config.local.json",
    "codegen": "playwright codegen https://admin.shopify.com/",
    "purge": "node src/purge.mjs --config config.local.json",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "playwright": "1.56.0"
  }
}
